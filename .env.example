# SMTP Configuration for Email OTP
# Generate an App Password from your Gmail account:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already enabled
# 3. Go to App passwords and create a password for "Mail" and "Windows Computer"
# 4. Copy the 16-character password and paste below

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# Database Configuration (if using environment variables)
# DATABASE_URL=postgresql://user:password@localhost/dbname
